<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<UseWindowsForms>true</UseWindowsForms>
		<ImplicitUsings>enable</ImplicitUsings>
		<ApplicationIcon>download.ico</ApplicationIcon>
	</PropertyGroup>

	<ItemGroup>
		<Content Include="download.ico" />
		<None Update="App.config">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="FontAwesome.Sharp" Version="6.6.0" />
		<PackageReference Include="MySql.Data" Version="26.7.0" />
		<PackageReference Include="MySqlConnector" Version="2.6.2" />
	</ItemGroup>

	<ItemGroup>
		<Compile Update="EditStudent.cs">
			<SubType>Form</SubType>
		</Compile>
		<Compile Update="frmStudent.cs">
			<SubType>Form</SubType>
		</Compile>
	</ItemGroup>

</Project>